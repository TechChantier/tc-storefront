              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"idempotency_key\": \"{{idempotency_key}}\",\n  \"customer\": {\n    \"name\": \"Jane Doe\",\n    \"phone\": \"670000001\",\n    \"country\": \"Cameroon\",\n    \"city\": \"Douala\",\n    \"address\": \"Akwa, Street 12\"\n  },\n  \"fulfillment\": {\n    \"method\": \"pickup\",\n    \"note\": \"Ready after 5pm\"\n  },\n  \"items\": [\n    {\n      \"product_id\": \"{{product_id}}\",\n      \"quantity\": 1\n    }\n  ],\n  \"locale\": \"{{locale}}\"\n}"
            },
            "url": {
              "raw": "{{tenant_base_url}}/api/storefront/orders",
              "host": [
                "{{tenant_base_url}}"
              ],
              "path": [
                "api",
                "storefront",
                "orders"
              ]
            },
            "description": "Same endpoint with `fulfilment.method = pickup` (no address). Always generates a fresh idempotency key."
          },
          "response": []
        }
      ]
    }
  ]
